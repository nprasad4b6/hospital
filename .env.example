# Backend Environment Variables

## Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hospital-queue

## Server
PORT=5000
NODE_ENV=development

## JWT
JWT_SECRET=your_jwt_secret_key_here

## Twilio (WhatsApp)
TWILO_ACCOUNT_SID=your_twilio_account_sid
TWILO_AUTH_TOKEN=your_twilio_auth_token
TWILO_PHONE_NUMBER=+1234567890
TWILO_WHATSAPP_NUMBER=whatsapp:+1234567890
SEND_WHATSAPP_ON_REGISTER=true

## Queue Settings
AVERAGE_CONSULTATION_TIME=15
BUFFER_TIME_MINUTES=10

## Frontend URLs
# LOCAL DEVELOPMENT:
# FRONTEND_URL=http://localhost:3000
# HOSPITAL_BASE_URL=http://localhost:3000

# PRODUCTION (Vercel/Render):
# FRONTEND_URL=https://your-deployed-frontend.vercel.app
# HOSPITAL_BASE_URL=https://your-deployed-frontend.vercel.app

FRONTEND_URL=http://localhost:3000
HOSPITAL_BASE_URL=http://localhost:3000
